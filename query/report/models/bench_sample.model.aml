  dimension s4 { label: 's4 (short text)' type: 'text' definition: @sql {{ #SOURCE.s4 }};; }
  dimension l4 { label: 'l4 (long text)' type: 'text' definition: @sql {{ #SOURCE.l4 }};; }
  dimension d4 { label: 'd4 (date)' type: 'text' definition: @sql {{ #SOURCE.d4 }};; }
  dimension t4 { label: 't4 (timestamp)' type: 'text' definition: @sql {{ #SOURCE.t4 }};; }
  dimension z4 { label: 'z4 (timestamptz)' type: 'text' definition: @sql {{ #SOURCE.z4 }};; }
  dimension x4 { label: 'x4 (boolean)' type: 'text' definition: @sql {{ #SOURCE.x4 }};; }
  dimension i5 { label: 'i5 (integer)' type: 'text' definition: @sql {{ #SOURCE.i5 }};; }
  dimension b5 { label: 'b5 (bigint)' type: 'text' definition: @sql {{ #SOURCE.b5 }};; }
  dimension n5 { label: 'n5 (numeric)' type: 'text' definition: @sql {{ #SOURCE.n5 }};; }
