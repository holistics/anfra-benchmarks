  dimension t5 { label: 't5 (timestamp)' type: 'text' definition: @sql {{ #SOURCE.t5 }};; }
  dimension z5 { label: 'z5 (timestamptz)' type: 'text' definition: @sql {{ #SOURCE.z5 }};; }
